# VoiXLib — Apache fallback (optional).
# Preferred local/dev workflow needs no Apache at all:
#   php -S localhost:8000 api/index.php
#
# For classic shared hosting, point DocumentRoot at this project root and
# this file routes every request through the same front controller Vercel uses.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Static assets live in public/assets
  RewriteRule ^assets/(.*)$ public/assets/$1 [L]

  # Real files/dirs win (none expected at root)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → front controller
  RewriteRule ^(.*)$ api/index.php [QSA,L]
</IfModule>

RedirectMatch 403 ^/?(/(app|config|storage|supabase|tools|resources|routes)(/|$))
RedirectMatch 403 ^/?.*\.env

Options -Indexes
