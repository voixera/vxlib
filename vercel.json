{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.7.3" }
  },
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "source": "/detail/:type/:id", "destination": "/api/index.php" },
    { "source": "/read/:type/:id", "destination": "/api/index.php" },
    { "source": "/manga", "destination": "/api/index.php" },
    { "source": "/manhwa", "destination": "/api/index.php" },
    { "source": "/manga/search", "destination": "/api/index.php" },
    { "source": "/manga/detail/:id", "destination": "/api/index.php" },
    { "source": "/manga/read/:id/:chapter", "destination": "/api/index.php" },
    { "source": "/baca/:id", "destination": "/api/index.php" },
    { "source": "/klasik", "destination": "/api/index.php" },
    { "source": "/(routes|app|config|resources|storage|tools|supabase)/(.*)", "destination": "/api/index.php" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ]
}
