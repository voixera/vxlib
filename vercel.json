{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "public/*.php": { "runtime": "vercel-php@0.7.3" },
    "public/auth/*.php": { "runtime": "vercel-php@0.7.3" },
    "public/api/*.php": { "runtime": "vercel-php@0.7.3" }
  },
  "rewrites": [
    { "source": "/", "destination": "/public/index.php" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
