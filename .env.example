# ── VoiXLib environment configuration ─────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env to Git.

# Base URL of the site, no trailing slash (e.g. https://voixlib.example)
APP_URL=http://localhost:8000
# production | development (development shows friendlier error output)
APP_ENV=development

# ── Discord OAuth2 ────────────────────────────────────────────────
# Create an application at https://discord.com/developers/applications
# In OAuth2 settings add redirect: {APP_URL}/auth/callback.php
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback.php

# ── Supabase ──────────────────────────────────────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — SERVER-SIDE ONLY. Never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admins ────────────────────────────────────────────────────────
# Comma-separated Discord user IDs allowed to use /admin.php
ADMIN_DISCORD_IDS=

# Optional overrides
SESSION_NAME=voixlib_session
